# 서버 설정
PORT=3001
NODE_ENV=development

# 네이버 광고 API 인증 정보
NAVER_CUSTOMER_ID=your-customer-id
NAVER_ACCESS_LICENSE=your-access-license
NAVER_SECRET_KEY=your-secret-key

# 네이버 광고 API 엔드포인트
NAVER_API_BASE_URL=https://api.searchad.naver.com

# 프론트엔드 URL (CORS)
FRONTEND_URL=http://localhost:3000

# 데이터베이스
DATABASE_PATH=./data/db.json

# 암호화 키 (API 키 저장용)
ENCRYPTION_KEY=your-32-character-secret-key-here

# 자동입찰 설정
AUTO_BID_INTERVAL_MINUTES=10
RANK_CHECK_INTERVAL_MINUTES=5
